# ==========================================
# NagarSetu Environment Configuration
# ==========================================

# Server
PORT=8080
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/NagarSetu

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRE=7d

# ==========================================
# Gemma AI Model Integration
# ==========================================
# Obtain your API key from Google AI Studio (https://aistudio.google.com/app/apikey)
# or your preferred Gemma provider.
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=your_gemma_model_here
# Optional custom API endpoint (defaults to Google Generative Language API if left blank)
# GEMMA_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# ==========================================
# Cloudinary (Image Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# Brevo SMTP (Email OTP Verification)
# ==========================================
BREVO_HOST=smtp-relay.brevo.com
BREVO_PORT=587
BREVO_USER=your_brevo_smtp_login
BREVO_PASS=your_brevo_smtp_key
BREVO_FROM_EMAIL=your_verified_sender_email@gmail.com
BREVO_FROM_NAME=NagarSetu

# ==========================================
# Civic AI Triage & SLA Engine Configuration
# ==========================================
PYTHON_PATH=python
AI_MODEL_PATH=ml/models
AI_CONFIDENCE_THRESHOLD=0.60
DUPLICATE_DISTANCE_METERS=300
DUPLICATE_TIME_WINDOW_HOURS=48
DEFAULT_CRITICAL_SLA_HOURS=4
DEFAULT_HIGH_SLA_HOURS=24
DEFAULT_MEDIUM_SLA_HOURS=72
DEFAULT_LOW_SLA_HOURS=168
